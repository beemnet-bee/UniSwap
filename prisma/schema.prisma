// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  role      String?
  school    String
  phone     String?
  students  String?
  message   String?
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  reply     String?
  repliedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminChat {
  id             String    @id @default(cuid())
  username       String
  message        String
  editedAt       DateTime?
  replyToId      String?
  replyToUsername String?
  replyToMessage String?
  attachment     String?
  attachmentName String?
  attachmentType String?
  createdAt      DateTime  @default(now())

  reactions AdminChatReaction[]
  seenBy    AdminChatSeen[]
}

model AdminChatReaction {
  id        String   @id @default(cuid())
  chatId    String
  username  String
  emoji     String
  createdAt DateTime @default(now())

  chat      AdminChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, username, emoji])
}

model AdminChatSeen {
  id        String   @id @default(cuid())
  chatId    String
  username  String
  seenAt    DateTime @default(now())

  chat      AdminChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, username])
}

model AdminChatSettings {
  id              String   @id @default("default")
  retentionDays   Int      @default(7)
  updatedAt       DateTime @updatedAt
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())
}
